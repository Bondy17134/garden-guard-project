CAMERA_USERNAME=replace-with-camera-username
CAMERA_PASSWORD=replace-with-camera-password
CAMERA_IP=192.168.0.164

# COCO labels supported by the supplied yolo11n model.
INTERESTING_CLASSES=bird,cat,dog,horse,sheep,cow,elephant,bear,zebra,giraffe,person
CONFIDENCE_THRESHOLD=0.75
SAVE_COOLDOWN_SECONDS=30
VISIT_END_SECONDS=3
SHOW_WINDOW=false
YOLO_DEVICE=0

# Linux server path that is mounted from the Windows Detections network share.
HOST_DETECTIONS_DIR=/mnt/garden-guard-detections
# Container path used by Garden Guard. Do not change this unless you update docker-compose.yml.
DETECTIONS_DIR=/detections
