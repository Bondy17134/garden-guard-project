CAMERA_USERNAME=replace-with-camera-username
CAMERA_PASSWORD=replace-with-camera-password
CAMERA_IP=192.168.0.164
# Use 'sub' when the high-resolution main stream is unstable.
CAMERA_STREAM=main

# COCO labels supported by the supplied yolo11n model.
INTERESTING_CLASSES=bird,cat,dog,horse,sheep,cow,elephant,bear,zebra,giraffe,person
CONFIDENCE_THRESHOLD=0.75
SAVE_COOLDOWN_SECONDS=30
VISIT_END_SECONDS=3
SHOW_WINDOW=false
YOLO_DEVICE=0
# Use a path in /app/runs to run a locally trained model, for example:
# YOLO_MODEL=/app/runs/bush_turkey_v1/weights/best.pt
YOLO_MODEL=yolo11n.pt

# Container path backed by ./storage on the Linux server.
DETECTIONS_DIR=/app/storage/detections
